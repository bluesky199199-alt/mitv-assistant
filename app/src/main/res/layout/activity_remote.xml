<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingTop="12dp">

    <!-- 顶栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/remote_title"
            android:textColor="@color/text_primary"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnSendText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_ripple_round"
            android:clickable="true"
            android:focusable="true"
            android:padding="6dp"
            android:text="@string/send_text"
            android:textColor="@color/mi_orange"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/targetText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="@color/text_secondary"
        android:textSize="11sp" />

    <!-- 音量滑条 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔊"
            android:textSize="14sp" />

        <com.google.android.material.slider.Slider
            android:id="@+id/volumeSlider"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="10dp"
            android:layout_weight="1"
            android:valueFrom="0"
            android:valueTo="100"
            android:stepSize="1"
            app:labelBehavior="floating"
            app:thumbColor="@color/mi_orange"
            app:trackColorActive="@color/mi_orange"
            app:trackColorInactive="#3A3F49" />

        <TextView
            android:id="@+id/volumeValueText"
            android:layout_width="34dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="--"
            android:textColor="@color/mi_orange"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- 信号源快捷 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSrcHdmi1"
            style="@style/ToolChip"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="@string/source_hdmi1" />

        <Space android:layout_width="8dp" android:layout_height="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSrcHdmi2"
            style="@style/ToolChip"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="@string/source_hdmi2" />

        <Space android:layout_width="8dp" android:layout_height="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSrcTv"
            style="@style/ToolChip"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="@string/source_tv" />
    </LinearLayout>

    <!-- 触控板：滑动移动 / 单击OK / 双击返回 -->
    <FrameLayout
        android:id="@+id/touchpad"
        android:layout_width="match_parent"
        android:layout_height="168dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_touchpad">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal|top"
            android:layout_marginTop="10dp"
            android:text="@string/touchpad_hint"
            android:textColor="#66FFFFFF"
            android:textSize="11sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOkPad"
            style="@style/RoundKey"
            android:layout_width="74dp"
            android:layout_height="74dp"
            android:layout_gravity="center"
            android:text="@string/key_ok"
            android:textSize="15sp" />
    </FrameLayout>

    <!-- 按键区两行 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPower"
            style="@style/KeyButton"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:text="@string/key_power" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMute"
            style="@style/KeyButton"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="@string/key_mute" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMenu"
            style="@style/KeyButton"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="@string/key_menu" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBack"
            style="@style/KeyButton"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:text="@string/key_back" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnHome"
            style="@style/PrimaryButton"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="@string/key_home" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVolUp"
            style="@style/KeyButton"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="@string/key_vol_up" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVolDown"
            style="@style/KeyButton"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="@string/key_vol_down" />
    </LinearLayout>

    <!-- 常用应用 -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/favRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingVertical="4dp" />
    </HorizontalScrollView>

    <Space android:layout_width="match_parent" android:layout_height="8dp" />
</LinearLayout>
